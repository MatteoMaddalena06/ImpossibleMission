enum Animation {
    PLAYER
    BLACKORB
    JUMPER_ROBOT
    ...
    SEARCHING_WINDOW
   
    -animationList: Map<Animation.State, List<BufferedImage>
    -Animation(animationLists: Map<Animation.State, List<BufferedImage>)
    +getAnimationList(): ap<Animation.State, List<BufferedImage>
}

enum Animation_State as "Animation.State"  {
    WALKING_LEFT, WALKING_RIGHT
    JUMPING_LEFT, JUMPING_RIGHT
    ...
    SEARCHING

    -id: int 
    +State(id: int)
    +State()
    +getState(movingObject: MovingObject): State
    +isMirrored(otherState: State): boolean
}

Animation_State ..> model.MovingObject

Animation *-- Animation_State

abstract ImageUtils {
    {static}+loadImage(pathname: String, crop: boolean): BufferedImage
    {static}+loadFlipped(pathname: String, crop: boolean): BufferedImage
    {static}+loadAnimation(pattern: String, start: int, end: int, crop: boolean): List<BufferedImage>
    {static}+loadFlippedAnimation(pattern: String, start: int, end: int, crop: boolean): List<BufferedImage>
    {static}-loadRaw(pathname: String): BufferedImage
    {static}-flipHorizontally(image: BufferedImage): BufferedImage
    {static}-crop(image: BufferedImage): BufferedImage
    {static}-imageStrip(image: BufferedImage, times: int, direction: ImageUtils.Direction): BufferedImage
    {static}-scaleImage(image: BufferedImage, width: int, height: int): BufferedImage
    {static}-getNumberAsImagesList(number: int, symbolsList: StaticImage[]): List<BufferedImage>
}

enum ImageUtils_Direction as "ImageUtils.Direction" {
    VERTICAL 
    HORIZONTAL
}

ImageUtils *.. ImageUtils_Direction
ImageUtils ..> StaticImage

enum StaticImage {
    GREEN_WALL_RIGHT
    GREEN_WALL_LEFT
    GREEN_UPPER_RIGHT_WALL
    ...
    NUMBER_9

    -image: BufferedImage
	-color: Room.Color
	-type: StaticImage.Type
	-furnitureType: Furniture.Type
    -furnitureLootType: Furniture.LootType
	-puzzlePieceType: PuzzlePiece
    -StaticImage(image: BufferedImage)
    -StaticImge(image: BufferdImage, color: Room.Color, type: StaticImage.Type, furnitureType: Furniture.Type, furnitureLootType: Furniture.LootType , puzzlePieceType: PuzzlePiece)
    -StaticImge(image: BufferdImage, color: Room.Color, type: StaticImage.Type, furnitureLootType: Furniture.LootType , puzzlePieceType: PuzzlePiece)
    -StaticImge(image: BufferdImage, color: Room.Color, type: StaticImage.Type, furnitureType: Furniture.Type)
    -StaticImge(image: BufferdImage, color: Room.Color, type: StaticImage.Type, furnitureLootType: Furniture.LootType)
    -StaticImge(image: BufferdImage, type: StaticImage.Type, furnitureLootType: Furniture.LootType)
    -StaticImge(image: BufferdImage, type: StaticImage.Type)
    -StaticImge(image: BufferdImage, color: Room.Color, type: StaticImage.Type)
    +getImage(): BufferdImage
    {static}+getFurniture(type: Furniture:Type, color: Room.Color): StaticImage
    {static}+getFurnitures(color: Room.Color): StaticImage[]
    {static}+getFloor(color: Room.Color): StaticImage
    {static}+getWall(color: Room.Color, wallType StaticImage.Type): StaticImage
    {static}+getPuzzlePiece(puzzlePiece: puzzlePiece): StaticImage
    {static}+getFurnitureLoot(furnitureLootType: Furniture.LootType): StaticImage
    {static}+getAwardsList(): List<StaticImage>
    {static}+getNumbersList(): List<StaticImage>
}

enum StaticImage_Type as "StaticImage.Type" {
    TERMINAL, MIDDLE_WALL_RIGHT, MIDDLE_WALL_LEFT, UPPER_LEFT_WALL, 
	UPPER_RIGHT_WALL, BOTTOM_LEFT_WALL, BOTTOM_RIGHT_WALL, FURNITURE, FLOOR, PLATFORM,
	FURNITURE_LOOT
}

StaticImage *-- StaticImage_Type
