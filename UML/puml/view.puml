    {static}-instance: AudioPlayer 
    -backgroundClip: Clip 
	-runningClips: Map<Object, Clip> 
    {static}+getInstance()
    -AudioPlayer()
    -playSample(audioSample: AudioData): void
    -startRunningClip(object: Object, audioSample: AudioData): void
    -removeRunningClip(object: Object): void
    -stopAllRunningClips(): void
    -startAllRunningClips(): void 
    -playBackgroundMusic: void
    -disposeBackgroundMusic(): void
    -disposeRunningClips(): void
}

AudioPlayer --> AudioData 

