class javax_swing_JPanel as "javax.swing.JPanel"
class javax_swing_JButton as "javax.swing.JButton"

class Renderer {
    -playerSprite: PlayerSprite
	-context: GameContext
	-currentSpritesList: List<Sprite> 
	-spritesListsCache: Map<Room, List<Sprite>> 
	-currentWindowY: double
	-printSearchingState: boolean
	-printFurnitureLoot: boolean
	-interestingFurniture: Furniture
	-firstPaintLatch: CountDownLatch
	-isFirstPaint: boolean
    +Renderer(context: GameContext)
    #paintComponent(g: Graphics): void
    -drawHUD(g: Graphics): void
    -paintImage(bindedGameObject: GameObject , image: BufferedImage , g: Graphics): void
    -paintFurnitureInfo(furniture: Furniture , image: BufferedImage , g: Graphics): void 
    -setCurrentSpritesList(): void 
    -addAttackSprite(attack: AttackerRobot.Attack): void
    -removeAttackSprite(attack: AttackerRobot.Attack): void
    -removeFurnitureSprite(furniture: Furniture): void
    -printFurnitureLoot(furniture: Furniture): void
    -printSearchingState(furniture: Furniture): void
    -bindAllKey(context: GameContext): void
    -bindKey(context: GameContext , keyName: String, keyCode: int, pressed: boolean): void
    +setFirstPaintLatch(latch: CountDownLatch): void
    +getCurrentSpritesList(): List<Sprite>
    +getPlayerSprite(): PlayerSprite
    +getPreferredSize(): Dimension 
}

Renderer --|> javax_swing_JPanel
Renderer --> PlayerSprite 
Renderer --> model.GameContext
Renderer --> model.Room
Renderer --> Sprite 
Renderer --> model.Furniture 
Renderer ..> model.GameObject
Renderer ..> model.AttackerRobot_Attack

Renderer ..> model.AttackLaunched      
Renderer ..> model.AttackEnded       
Renderer ..> model.FurnitureSearchEnded
Renderer ..> model.PlayerFoundSomething
Renderer ..> model.PlayerIsSearching

abstract Sprite {
    -image: BufferedImage
    -gameObject: GameObject 
    +Sprite(gameObject: GameObject)
    +computeImage(): void //abstract 
    +getImage(): BufferedImage
    +setImage(image: BufferedImage): void 
    +getGameObject(): GameObject
}

Sprite --> model.GameObject

abstract AnimatedSprite {
    -animation: Animation
	-previousState: Animation.State
	-imageDuration: double
	-elapsedTime: double
	-imageIndex: int
    +AnimatedSprite(gameObject: MovingObject, animation Animation, imageDuration: double)
    +computeImage(): void
    #nextImageIndex(animationList: List<BufferedImage>): int
    +updateElapsedTime(deltaTime: double): void
    #getImageIndex(): int
}

AnimatedSprite --|> Sprite 
AnimatedSprite --> Animation 
AnimatedSprite --> Animation_State 
AnimatedSprite ..> model.MovingObject

